 not recorded."]},"home":{"cu":27950,"cv":900,"k":1.05},"walk":{"centre":[28000,860],"reach":1800,"start":[28120,900],"facing":[-1,0],"dist":1350,"pitch":26},"pois":[{"id":"boats","title":"Grain boats","zh":"粮船","at":{"tree":"grain-boat","h":470},"body":"In the Northern Song the Bian River was the main route carrying grain from the south to the capital, Kaifeng. Here two deep-laden boats are moored at the bank.","link":["index.html#grain","This scene on the scroll"]},{"id":"porters","title":"Porters with sacks","zh":"卸粮","at":{"tree":"porter-2","h":170},"body":"Porters carry the sacks ashore on their backs, one after another, to a man seated on the pile."},{"id":"sheds","title":"Sheds on the bank","zh":"食棚","at":{"model":"tea-shed","h":320},"body":"Along the bank, people eat and drink at tables under open sheds, looking out over the boats."}],"sound":{"water":[27400,1350],"crowds":[[28100,800,160,4,0.09],[28600,600,160,3,0.07],[27400,700,160,3,0.06]],"birds":5,"creaks":["grain-boat","boat-2","boat-3"]},"walker":{"height":88,"feet":[1253,1242],"pieces":[{"id":"body","file":"walker-body.png","box":[1155,1057,1351,1251]},{"id":"basket-left","file":"walker-basket-left.png","box":[1137,1095,1221,1219],"pivot":[1186,1094]},{"id":"basket-right","file":"walker-basket-right.png","box":[1287,1101,1373,1221],"pivot":[1336,1098]}]},"crowd":{"height":84,"people":[{"id":"grain-talker-1","file":"crowd-grain-talker-1.png","box":[28049,612,28125,773],"feet":[28087,770],"top":615,"faces":"right"},{"id":"grain-talker-2","file":"crowd-grain-talker-2.png","box":[28122,655,28201,800],"feet":[28162,797],"top":658,"faces":"right"},{"id":"gate-walker-1","file":"crowd-gate-walker-1.png","box":[6089,1209,6208,1423],"feet":[6148,1420],"top":1212,"faces":"right"},{"id":"gate-walker-2","file":"crowd-gate-walker-2.png","box":[5795,1077,5871,1285],"feet":[5833,1282],"top":1080,"faces":"left"},{"id":"end-walker-1","file":"crowd-end-walker-1.png","box":[1845,1117,1921,1267],"feet":[1883,1264],"top":